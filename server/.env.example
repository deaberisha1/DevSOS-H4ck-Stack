# Server
# Port 3000 matches client/vite.config.ts's dev proxy target — the frontend
# dev server runs on 5173 and proxies /api and /socket.io to this port.
PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=devsos

# Frontend origin (CORS) — the Vite dev server's own port, since that's
# what the browser sees as the request's Origin even when proxied
APP_ORIGIN=http://localhost:5173

# Secret key for event creation (organizer auth)
EVENT_SETUP_KEY=change_me_in_production

# Secret used to sign the session cookie (cookie-parser). Any long random
# string works for a hackathon — just keep it out of git.
COOKIE_SECRET=change_me_in_production

# AWS Bedrock (for AI assistant)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
